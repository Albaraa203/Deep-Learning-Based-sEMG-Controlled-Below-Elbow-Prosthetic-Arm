def init_h5_file(filepath, name, age):
    import h5py  # <--- الاستيراد يتم هنا فقط لحظة إنشاء الملف
    with h5py.File(filepath, 'w') as f:
        f.attrs['Subject_Name'] = name
        f.attrs['Subject_Age'] = age
        f.create_dataset('sEMG_Data',
                         shape=(0, 6),
                         maxshape=(None, 6),
                         dtype='float32',
                         chunks=(2000, 6))

def append_to_h5(filepath, chunk_data_5ch, movement_label):
    import h5py  # <--- الاستيراد يتم هنا فقط لحظة الكتابة
    if chunk_data_5ch.shape[0] == 0:
        return
    N = chunk_data_5ch.shape[0]
    labels = np.full((N, 1), movement_label, dtype=np.float32)
    data_to_append = np.hstack((chunk_data_5ch, labels))

    with h5py.File(filepath, 'a') as f:
        dataset = f['sEMG_Data']
        current_size = dataset.shape[0]
        dataset.resize((current_size + N, 6))
        dataset[current_size:] = data_to_append

# ──────────────────────────────────────────────────────────────
#  Shared Memory Ring Buffer (Tear-Free)
# ──────────────────────────────────────────────────────────────
class SharedRingBuffer:
    def __init__(self, size: int):
        self._size = size
        self._buf = mp.Array(ctypes.c_float, size, lock=False)
        self._head = mp.Value(ctypes.c_int, 0, lock=False)

    def append(self, value: float):
        h = self._head.value
        self._buf[h] = value
        self._head.value = (h + 1) % self._size

    def extend(self, values: np.ndarray):
        h = self._head.value
        n = len(values)
        if n == 0: return
        snapshot = np.frombuffer(self._buf, dtype=np.float32)
        
        if h + n <= self._size:
            snapshot[h:h+n] = values
        else:
            overflow = (h + n) % self._size
            snapshot[h:] = values[:self._size - h]
            snapshot[:overflow] = values[self._size - h:]
            
        self._head.value = (h + n) % self._size

    def read_latest(self, count: int) -> np.ndarray:
        h = self._head.value
        safe_head = (h - 2) % self._size
        
        snapshot = np.frombuffer(self._buf, dtype=np.float32)
        
        if safe_head >= count:
            return snapshot[safe_head - count : safe_head].copy()
        else:
            part1 = snapshot[self._size - (count - safe_head):]
            part2 = snapshot[:safe_head]
            return np.concatenate((part1, part2))

    def read_forward(self, start_idx: int, count: int) -> np.ndarray:
        snapshot = np.frombuffer(self._buf, dtype=np.float32)
        if start_idx + count <= self._size:
            return snapshot[start_idx : start_idx + count].copy()
        else:
            part1 = snapshot[start_idx:]
            part2 = snapshot[: (start_idx + count) % self._size]
            return np.concatenate((part1, part2))

# ──────────────────────────────────────────────────────────────
#  1. Acquisition Process (Hardware Level - 6000 Hz)
# ──────────────────────────────────────────────────────────────
def acquisition_worker(raw_buffers, sample_count, running_flag):
    import spidev
    import pigpio  
    import RPi.GPIO as GPIO
    
    try:
        os.sched_setaffinity(0, {3})
        param = os.sched_param(99)
        os.sched_setscheduler(0, os.SCHED_FIFO, param)
    except PermissionError:
        print("\n[تحذير خطير]: عملية القراءة لم تأخذ الأولوية القصوى! يجب تشغيل السكريبت بـ sudo لضمان ثبات السامبلينج.\n")
    except Exception as e:
        pass 
        
    os.system("sudo taskset -cp 3 $(pgrep pigpiod) > /dev/null 2>&1")
    
    pi = pigpio.pi()
    if not pi.connected:
        print("[خطأ جسيم]: خدمة pigpio لا تعمل! تأكد من تنفيذ الأمر: sudo systemctl start pigpiod")
        running_flag.value = False
        return

    GPIO.setwarnings(False)
    GPIO.setmode(GPIO.BCM)
    GPIO.setup(RESET, GPIO.OUT)
    GPIO.setup(BUSY, GPIO.IN)

    spi = spidev.SpiDev()
    spi.open(0, 0)
    spi.max_speed_hz = 10_000_000 
    spi.mode = 0b10

    GPIO.output(RESET, GPIO.HIGH)
    time.sleep(0.001)
    GPIO.output(RESET, GPIO.LOW)

    _UNPACK = struct.Struct('>8h')

    pi.hardware_PWM(CONVST, SAMPLING_RATE, 500000)

    while running_flag.value:
        while GPIO.input(BUSY) == GPIO.LOW:
            if not running_flag.value: break
             
        while GPIO.input(BUSY) == GPIO.HIGH:
            pass 

        raw_data = spi.readbytes(BYTES_PER_SAMPLE)
        ch_raw = _UNPACK.unpack(bytes(raw_data))
        
        for ch in range(NUM_CHANNELS): 
            v = (ch_raw[ch] / 32768.0) * VREF
            raw_buffers[ch].append(v)

        sample_count.value += 1

    pi.hardware_PWM(CONVST, 0, 0) 
    pi.stop()                     
    spi.close()
    GPIO.cleanup()

# ──────────────────────────────────────────────────────────────
#  2. DSP Process (Preprocessing & Decimation Bridge)
# ──────────────────────────────────────────────────────────────
def dsp_worker(raw_buffers, processed_buffers, running_flag):
    import os
    try:
        os.sched_setaffinity(0, {2})
        param = os.sched_param(98)
        os.sched_setscheduler(0, os.SCHED_FIFO, param)
    except PermissionError:
        print("\n[تحذير خطير]: عملية الفلترة لم تأخذ الأولوية القصوى! يرجى استخدام sudo.\n")
    except Exception:
        pass

    raw_size = raw_buffers[0]._size
    last_heads = [0] * NUM_CHANNELS
    
    fs = float(SAMPLING_RATE)
    
    # Notch filter Q modified to 20.0
    b_notch, a_notch = signal.iirnotch(50.0, 2.0, fs=fs)
    sos_notch = signal.tf2sos(b_notch, a_notch)
    zi_notch_base = signal.sosfilt_zi(sos_notch)
    
    sos_bp = signal.butter(4, [20.0, 500.0], btype='bandpass', fs=fs, output='sos')
    zi_bp_base = signal.sosfilt_zi(sos_bp)
    
    zi_notch_states = [None] * NUM_CHANNELS
    zi_bp_states = [None] * NUM_CHANNELS
    filters_initialized = [False] * NUM_CHANNELS

    while running_flag.value:
        for ch in range(NUM_CHANNELS):
            current_head = raw_buffers[ch]._head.value
            last_head = last_heads[ch]
            
            if current_head == last_head:
                continue
                
            if current_head > last_head:
                new_count = current_head - last_head
            else:
                new_count = raw_size - last_head + current_head
                
            remainder = new_count % 3
            processed_count = new_count - remainder
            
            if processed_count > 0:
                raw_snap = np.frombuffer(raw_buffers[ch]._buf, dtype=np.float32)
                
                if last_head + processed_count <= raw_size:
                    chunk = raw_snap[last_head : last_head + processed_count].copy()
                else:
                    overflow = (last_head + processed_count) % raw_size
                    chunk = np.concatenate((raw_snap[last_head:], raw_snap[:overflow]))
                    
                chunk_64 = chunk.astype(np.float64)

                if not filters_initialized[ch]:
                    zi_notch_states[ch] = zi_notch_base * chunk_64[0]
                    zi_bp_states[ch] = zi_bp_base * chunk_64[0]
                    filters_initialized[ch] = True

                filtered_chunk_notch, zi_notch_states[ch] = signal.sosfilt(sos_notch, chunk_64, zi=zi_notch_states[ch])
                filtered_chunk_final, zi_bp_states[ch] = signal.sosfilt(sos_bp, filtered_chunk_notch, zi=zi_bp_states[ch])
                
                filtered_chunk = filtered_chunk_final.astype(np.float32)
                decimated_chunk = filtered_chunk[::3]
                processed_buffers[ch].extend(decimated_chunk)
                
                last_heads[ch] = (last_head + processed_count) % raw_size
                
        time.sleep(0.005)

