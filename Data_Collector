                                       args=(self._raw_buffers, self._processed_buffers, self._running_flag))
        
        self._acq_process.start()
        self._dsp_process.start()

        # Timers
        self._plot_timer = QTimer(self)
        self._plot_timer.setInterval(PLOT_INTERVAL)
        self._plot_timer.timeout.connect(self._refresh_plot)
        self._plot_timer.start()

        self._rate_timer = QTimer(self)
        self._rate_timer.setInterval(1000)
        self._rate_timer.timeout.connect(self._update_rate) 
        self._rate_timer.start()

        self._record_timer = QTimer(self)
        self._record_timer.setInterval(100)
        self._record_timer.timeout.connect(self._recording_loop)
        self._record_timer.start()

        self._x = np.arange(MAX_DISPLAY, dtype=np.float32)
        self._update_plot_ranges() 

    # --- Dataset Control Logic ---
# --- Dataset Control Logic ---
    def _on_new_subject(self):
        from PySide6.QtWidgets import QMessageBox

        # لو مفيش ملف شغال، يبقى إحنا بنعمل شخص جديد
        if self._h5_filepath is None:
            name, ok1 = QInputDialog.getText(self, "New Subject", "Enter Subject Name:")
            if not ok1 or not name.strip(): return

            age, ok2 = QInputDialog.getInt(self, "New Subject", "Enter Subject Age:", min=1, max=120)
            if not ok2: return

            self._h5_filepath = f"Subject_{name.strip().replace(' ', '_')}_{int(time.time())}.h5"
            init_h5_file(self._h5_filepath, name, age)

            # تغيير شكل الزرار ليصبح زرار إغلاق أحمر
            self._new_subject_btn.setText("Save Data / Close File")
            self._new_subject_btn.setStyleSheet("background-color: #d32f2f; color: white; font-weight: bold;")
            self._combo_movement.setEnabled(True)
            self._on_movement_changed() 
            
        # لو في ملف شغال، يبقى إحنا عايزين نقفله ونحفظ
        else:
            reply = QMessageBox.question(self, "Confirm Close", "Are you sure you want to lock and close this dataset?", QMessageBox.Yes | QMessageBox.No)
            if reply == QMessageBox.Yes:
                # تصفير كل المتغيرات لتهيئتها لشخص جديد
                self._h5_filepath = None
                self._completed_movements.clear()
                self._current_round = 1
                self._is_recording = False
                
                # إرجاع الواجهة الرسومية لوضعها الأصلي
                self._new_subject_btn.setText("New Subject")
                self._new_subject_btn.setStyleSheet("")
                self._combo_movement.setEnabled(True)
                self._record_btn.setEnabled(False)
                self._record_btn.setText("Record M1 - R1")
                self._progress_bar.setValue(0)


    def _on_movement_changed(self):
        mov_idx = self._combo_movement.currentIndex() + 1
        if mov_idx in self._completed_movements:
            self._record_btn.setText(f"Movement {mov_idx} Completed")
            self._record_btn.setEnabled(False)
        else:
            self._current_round = 1
            self._record_btn.setText(f"Record M{mov_idx} - R1")
            self._record_btn.setEnabled(self._h5_filepath is not None)

    def _on_record_clicked(self):
        if self._h5_filepath is None: return

        for ch in range(NUM_CHANNELS):
            self._last_read_heads[ch] = self._processed_buffers[ch]._head.value

        self._ignored_count = 0
        self._saved_count = 0
        self._progress_bar.setValue(0)
        self._is_recording = True

        self._record_btn.setEnabled(False)
        self._combo_movement.setEnabled(False)

    def _recording_loop(self):
        if not self._is_recording:
            return

        counts = []
        for ch in range(NUM_CHANNELS):
            h = self._processed_buffers[ch]._head.value
            last = self._last_read_heads[ch]
            size = self._processed_buffers[ch]._size
            count = h - last if h >= last else size - last + h
            counts.append(count)

        min_count = min(counts)
        if min_count == 0:
            return

        channels_data = []
        for ch in range(NUM_CHANNELS):
            data = self._processed_buffers[ch].read_forward(self._last_read_heads[ch], min_count)
            channels_data.append(data)
            self._last_read_heads[ch] = (self._last_read_heads[ch] + min_count) % self._processed_buffers[ch]._size

        chunk_data_5ch = np.column_stack(channels_data)
        mov_label = self._combo_movement.currentIndex() + 1

        if self._ignored_count < IGNORE_SAMPLES:
            remaining_ignore = IGNORE_SAMPLES - self._ignored_count
            ignore_now = min(remaining_ignore, min_count)
            self._ignored_count += ignore_now
            chunk_data_5ch = chunk_data_5ch[ignore_now:]
            min_count -= ignore_now

        if min_count == 0:
            return

        remaining_save = SAMPLES_PER_ROUND - self._saved_count
        save_now = min(remaining_save, min_count)
        data_to_save = chunk_data_5ch[:save_now]

        append_to_h5(self._h5_filepath, data_to_save, mov_label)
        
        self._saved_count += save_now
        self._progress_bar.setValue(self._saved_count)

        if self._saved_count >= SAMPLES_PER_ROUND:
            self._is_recording = False
            if self._current_round == 1:
                self._current_round = 2
                self._record_btn.setText(f"Record M{mov_label} - R2")
                self._record_btn.setEnabled(True)
            else:
                self._completed_movements.add(mov_label)
                self._combo_movement.setEnabled(True)
                self._on_movement_changed() 

    # --- Plot UI Updates ---
    def _update_plot_ranges(self):
        x_max = self._x_slider.value()
        y_max = self._y_slider.value() / 10.0 
        
        self._plot_widget.setXRange(0, x_max, padding=0)
        self._plot_widget.setYRange(-y_max, y_max, padding=0)

    def _refresh_plot(self):
        data = self._processed_buffers[self._active_ch].read_latest(MAX_DISPLAY + 500)
        
        dc_offset = np.mean(data)
        crossings = np.where((data[:-1] < dc_offset) & (data[1:] >= dc_offset))[0]
        
        valid_crossings = [c for c in crossings if (len(data) - c) >= MAX_DISPLAY]
        
        if valid_crossings:
            trig_idx = valid_crossings[-1]
            plot_data = data[trig_idx : trig_idx + MAX_DISPLAY]
        else:
            plot_data = data[-MAX_DISPLAY:]

        self._curve.setData(self._x, plot_data) 

    def _on_channel_changed(self, idx: int):
        self._active_ch = idx

    def _update_rate(self):
        hz = self._sample_count.value
        self._sample_count.value = 0
        self._rate_lbl.setText(f"{hz} Hz (Raw HW)")

    def closeEvent(self, event):
        self._plot_timer.stop()
        self._rate_timer.stop()
        self._record_timer.stop()
        self._running_flag.value = False
        self._acq_process.join(timeout=1.0)
        self._dsp_process.join(timeout=1.0)
        event.accept()

# ──────────────────────────────────────────────────────────────
#  Entry Point
# ──────────────────────────────────────────────────────────────
def main():
    try:
        os.sched_setaffinity(0, {0, 1})
    except Exception:
        pass

    mp.freeze_support()
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    win = MainWindow()
    win.show()
    exit_code = app.exec()
    sys.exit(exit_code)

if __name__ == "__main__":
    main()
