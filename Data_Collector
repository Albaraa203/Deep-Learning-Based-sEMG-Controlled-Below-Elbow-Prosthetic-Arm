# ──────────────────────────────────────────────────────────────
#  Constants
# ──────────────────────────────────────────────────────────────
CONVST      = 18          
BUSY        = 27
RESET       = 24

SAMPLING_RATE             = 6000          
RAW_BUFFER_CAPACITY       = 18000         
PROCESSED_BUFFER_CAPACITY = 6000          
MAX_DISPLAY               = 2000          

# Phase 1 Adjustments
NUM_CHANNELS      = 5   
SAMPLES_PER_ROUND = 156425
IGNORE_SAMPLES    = 5000
MOVEMENT_COUNT    = 8

PLOT_FPS        = 30            
PLOT_INTERVAL   = 1000 // PLOT_FPS   

VREF             = 5.0               
BYTES_PER_SAMPLE = 16           

